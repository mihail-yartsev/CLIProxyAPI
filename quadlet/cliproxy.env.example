# Copy this file to ~/.config/cliproxy/cliproxy.env
# and set only the entries you need.

# Optional: management key for /v0/management API.
# WARNING: if set, this codebase allows remote management access when reachable.
# MANAGEMENT_PASSWORD=replace-with-a-long-random-secret

# Optional cloud mode switch.
# DEPLOY=cloud

# Optional Postgres token store.
# PGSTORE_DSN=postgresql://user:pass@db-host:5432/cliproxy
# PGSTORE_SCHEMA=public
# PGSTORE_LOCAL_PATH=/var/lib/cliproxy/pgstore

# Optional Git-backed config store.
# GITSTORE_GIT_URL=https://github.com/your-org/cli-proxy-config.git
# GITSTORE_GIT_USERNAME=git-user
# GITSTORE_GIT_TOKEN=ghp_xxx
# GITSTORE_LOCAL_PATH=/var/lib/cliproxy/gitstore

# Optional object store token store.
# OBJECTSTORE_ENDPOINT=https://s3.example.com
# OBJECTSTORE_BUCKET=cli-proxy-config
# OBJECTSTORE_ACCESS_KEY=xxx
# OBJECTSTORE_SECRET_KEY=xxx
# OBJECTSTORE_LOCAL_PATH=/var/lib/cliproxy/objectstore
